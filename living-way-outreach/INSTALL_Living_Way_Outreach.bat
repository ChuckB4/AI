@echo off
title Living Way UPC Outreach - Installer
echo.
echo   Setting up your Living Way UPC Outreach kit...
echo   Please wait a few seconds.
echo.
set "DEST=%USERPROFILE%\Desktop\LivingWay_Outreach_Kit"
if not exist "%DEST%" mkdir "%DEST%"
set "TGZ=%TEMP%\lwupc_payload.tgz"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$line = Select-String -Path '%~f0' -Pattern '^::DATA::' | Select-Object -First 1; $b64 = (Get-Content '%~f0')[$line.LineNumber]; [IO.File]::WriteAllBytes($env:TGZ, [Convert]::FromBase64String($b64)); tar -xzf $env:TGZ -C $env:DEST; Remove-Item $env:TGZ -ErrorAction SilentlyContinue"
echo.
echo   DONE! Your kit is on your Desktop in the folder: LivingWay_Outreach_Kit
echo   To use it, open that folder and double-click "Start Here".
echo.
start "" "%DEST%"
pause
exit /b
::DATA::

